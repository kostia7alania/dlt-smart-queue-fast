{
  "name": "thai-driving-license",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/web/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/healthz", "/v1/*"]
  },
  "kv_namespaces": [
    {
      "binding": "OFFICE_SNAPSHOTS",
      "id": "8d0e349135304e819bf5dd5da489c5f4"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "vars": {
    "OFFICE_REFRESH_MIN_AGE_SECONDS": "1800",
    "OFFICE_SOURCE_URL": "https://app-gecc.theassistech.co.th/dlt-api1/getSite/2"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
