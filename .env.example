DATABASE_URL=postgres://myuser:mypassword@localhost:5432/mydb?sslmode=disable
API_PORT=8080
DATABASE_REQUIRED=false
DB_MAX_CONNS=5
CORS_ALLOWED_ORIGINS=http://localhost:3000
WEB_PORT=3000
DLT_API_BASE_URL=https://app-gecc.theassistech.co.th
# Opaque token sent as the workfilter "username" field to the upstream DLT API.
# Leave empty if your environment does not require it.
DLT_WORKFILTER_TOKEN=
DLT_MAX_CONCURRENCY=4
SLOT_SNAPSHOT_RETENTION_DAYS=365
FETCH_LOG_RETENTION_DAYS=30
# Local Go API. Use an explicitly empty value for the same-origin Cloudflare Worker in production.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public origin, no trailing slash. First production: exact workers.dev origin.
# A future custom domain replaces this value at build time and updates every canonical.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=Thai Driving License
